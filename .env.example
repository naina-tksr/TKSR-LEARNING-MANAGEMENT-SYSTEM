# TKSR Learning - environment configuration
# Copy this file to `.env` and adjust the values.

# ---- API server ----
NODE_ENV=development
PORT=5175
# Comma-separated allowed CORS origins (not needed when using the Vite dev proxy)
CORS_ORIGIN=http://localhost:5174

# ---- Database (SQLite, relational) ----
# Path is resolved relative to the project root.
DATABASE_PATH=server/data/tksr.sqlite

# ---- Authentication ----
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---- File uploads ----
UPLOAD_DIR=server/uploads
MAX_UPLOAD_MB=5

# ---- AI provider (server-side only, never exposed to the browser) ----
# provider: `auto` (use OpenAI when a key is set, otherwise the built-in mock),
# `openai` (require a key), or `mock` (always offline/deterministic).
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
