{
  "name": "tksr-learning-lms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TKSR Learning - AI-focused Learning Management System (LMS) MVP",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --port 5174 --host",
    "db:migrate": "tsx server/src/db/migrate-cli.ts",
    "db:seed": "tsx server/src/db/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "tsc -p server/tsconfig.build.json",
    "start": "node dist-server/index.js",
    "typecheck": "vue-tsc --noEmit && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
